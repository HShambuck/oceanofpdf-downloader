{
  "manifest_version": 3,
  "name": "OceanofPDF Batch Downloader",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://oceanofpdf.com/*",
    "https://*.degital5.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://oceanofpdf.com/*",
        "https://*.degital5.com/*"
      ],
      "js": [
        "src/content.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}